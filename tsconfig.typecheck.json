{
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/api/**/*",
    "src/lib/**/*",
    "src/hooks/**/*",
    "src/services/**/*",
    "src/utils/**/*",
    "vite.config.js"
  ],
  "exclude": ["node_modules", "dist"]
}
