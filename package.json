  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "backup:storage": "node scripts/storage-backup.mjs",
    "preview": "vite preview",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./tsconfig.json",
    "typecheck:js": "tsc -p ./jsconfig.json",
    "typecheck:strict": "node scripts/strict-typecheck.mjs",
    "typecheck:noimplicitany": "node scripts/noimplicitany-typecheck.mjs",
    "types:db": "supabase gen types typescript --project-id kjrwqagyeswwoxpjkcko > src/types/supabase.ts",
    "perf:bundle": "node scripts/perf-bundle-report.cjs",
    "perf:trace": "node scripts/perf-browser-trace.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:staging:readonly": "playwright test e2e/smoke.spec.ts e2e/daily-workflow.spec.ts",
    "test:e2e:staging:mutations": "playwright test e2e/fab-release-gate.spec.ts e2e/piece-control-pilot.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
