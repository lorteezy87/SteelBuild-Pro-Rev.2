# Supabase - required for local development
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# Provider API keys belong in Supabase Edge Function secrets, not VITE_* browser variables.

# Error monitoring (Sentry) — initialised in src/instrument.js (error capture +
# performance tracing + masked session replay). A project DSN is baked in as a
# safe public fallback (DSNs are write-only ingest keys meant to ship in the
# browser), so monitoring works out of the box. Set VITE_SENTRY_DSN to override
# (e.g. a per-environment project) or point at your own org.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# VITE_APP_VERSION=               # optional: release tag for grouping (e.g. git SHA)
#
# Source-map upload (build-time only, NOT browser/VITE_* vars). When
# SENTRY_AUTH_TOKEN is set, vite.config.js enables @sentry/vite-plugin to upload
# hidden source maps so production stack traces are un-minified. All three are
# read from the environment at build time and must NOT be committed — set them in
# the Vercel project env (Production + Preview). Builds without the token skip the
# upload entirely. See docs/enterprise-readiness-handoff-2026-05-26.md.
# SENTRY_AUTH_TOKEN=              # Sentry auth token (scopes: project:releases, org:read) — SECRET
# SENTRY_ORG=                     # Sentry org slug
# SENTRY_PROJECT=                 # Sentry project slug
