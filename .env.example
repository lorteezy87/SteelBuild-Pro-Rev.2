# Supabase - required for local development
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# Provider API keys belong in Supabase Edge Function secrets, not VITE_* browser variables.

# Error monitoring (Sentry) — OPTIONAL. Leave VITE_SENTRY_DSN unset to disable
# entirely (the SDK is never loaded). Set it (in Vercel project env for prod) to
# turn on error reporting via src/lib/telemetry.js.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# VITE_SENTRY_RELEASE=            # optional: release/version tag for grouping
# VITE_SENTRY_TRACES_RATE=0.1     # optional: performance trace sample rate (0..1)
