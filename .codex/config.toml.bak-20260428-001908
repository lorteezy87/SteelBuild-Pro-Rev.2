# SteelBuild Pro Rev.2 — Codex Project Configuration
# Stack: Next.js 14 (App Router) + Supabase + TypeScript + Tailwind

project_root = 'C:\dev\SteelBuild-Pro-Rev.2'
project_name = "SteelBuild-Pro-Rev.2"

# ──────────────────────────────────────────────
# Model & Behavior
# ──────────────────────────────────────────────
model = "claude-opus-4-7"
approval_policy = "on-request"
sandbox_mode = "workspace-write"

# ──────────────────────────────────────────────
# Trusted Paths
# ──────────────────────────────────────────────
[trust]
paths = [
  'C:\dev\SteelBuild-Pro-Rev.2',
]

# ──────────────────────────────────────────────
# Sandbox / Workspace Permissions
# ──────────────────────────────────────────────
[sandbox_workspace_write]
network_access = true
writable_roots = [
  'C:\dev\SteelBuild-Pro-Rev.2',
]
exclude_tmpdir_env_var = false
exclude_slash_tmp = false

# ──────────────────────────────────────────────
# Shell Environment (Windows / PowerShell)
# ──────────────────────────────────────────────
[shell_environment_policy]
inherit = "all"
ignore_default_excludes = false
exclude = [
  "SUPABASE_SERVICE_ROLE_KEY",
  "SUPABASE_ACCESS_TOKEN",
  "OPENAI_API_KEY",
  "ANTHROPIC_API_KEY",
  "GITHUB_TOKEN",
]

[shell_environment_policy.set]
NODE_ENV = "development"
NEXT_TELEMETRY_DISABLED = "1"

# ──────────────────────────────────────────────
# File Patterns — What Codex Should/Shouldn't Touch
# ──────────────────────────────────────────────
[file_patterns]
exclude = [
  "node_modules/**",
  ".next/**",
  "out/**",
  "dist/**",
  "build/**",
  ".vercel/**",
  ".turbo/**",
  "coverage/**",
  "*.log",
  ".env",
  ".env.local",
  ".env*.local",
  "supabase/.branches/**",
  "supabase/.temp/**",
  ".git/**",
  "*.tsbuildinfo",
]

include_priority = [
  "app/**",
  "components/**",
  "lib/**",
  "hooks/**",
  "utils/**",
  "types/**",
  "supabase/migrations/**",
  "supabase/functions/**",
  "package.json",
  "tsconfig.json",
  "next.config.*",
  "tailwind.config.*",
  "middleware.ts",
]

# ──────────────────────────────────────────────
# MCP Servers (optional — uncomment as needed)
# ──────────────────────────────────────────────
# [mcp_servers.supabase]
# command = "npx"
# args = ["-y", "@supabase/mcp-server-supabase@latest"]

# [mcp_servers.github]
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-github"]

# ──────────────────────────────────────────────
# Project Context — Pass to Model on Every Session
# ──────────────────────────────────────────────
[project_context]
description = """
SteelBuild Pro Rev.2 — purpose-built construction PM web application for
structural steel fabricators and erectors. Migrated from Base44 to a
Next.js 14 (App Router) + Supabase + TypeScript + Tailwind stack.

Design system:
- Executive-grade dark industrial aesthetic
- Safety Orange (#FF6B1A) as CTA / critical accent
- Green for approved/released states
- Dynamic row-level status tinting
- IBM Plex Mono for numbers/codes
- Space Grotesk for headings
- 2px border-radius
- All colors via CSS variables
- No <form> tags — use onClick/onChange handlers
- Inline hover state handling

Domain conventions:
- Drawing stages: OFA, BFA, OFS, BFS, FFF, Released
- 7-phase WBS: Detailing, Procurement, Fabrication, Delivery, Equipment,
  Installation/Erection, Closeout
- SES gates and delegated design workflows
"""

conventions = [
  "TypeScript strict mode — no `any` unless justified",
  "Server Components by default; 'use client' only when needed",
  "Supabase queries via typed client (lib/supabase/server.ts, lib/supabase/client.ts)",
  "All DB access through RLS-aware clients — never service role on client",
  "Migrations live in supabase/migrations with timestamp prefix",
  "No <form> tags — use button onClick handlers",
  "CSS variables for all colors — no hardcoded hex in components",
  "Use IBM Plex Mono for numbers, codes, IDs; Space Grotesk for headings",
]

# ──────────────────────────────────────────────
# Common Commands (reference for Codex)
# ──────────────────────────────────────────────
[commands]
dev = "npm run dev"
build = "npm run build"
lint = "npm run lint"
typecheck = "npx tsc --noEmit"
db_push = "npx supabase db push"
db_diff = "npx supabase db diff"
gen_types = "npx supabase gen types typescript --local > types/supabase.ts"