#env
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
**/.next
# Claude Code: track shared project config (settings.json) + hooks; ignore local/session settings
.claude/settings.local.json
steelbuild-pro
SteelBuild-Pro-Rev.2/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.vercel

# temp commit-message files used by automation
.git-commit-msg.tmp

# local agent/session configuration
.codex/config.toml

# extracted theme handoff (preview/reference only)
.theme-reference/

# web-ifc wasm — generated by the copyWebIfcWasm vite plugin from node_modules
# on every build/dev start so it always matches the installed web-ifc version.
public/wasm/

# desktop launcher photo pipeline: raw source images + the local sharp install
# (scripts/optimize-desktop-photos.mjs). Optimized .webp outputs ARE committed.
public/photos/desktop/_raw/
scripts/.imgtools/

# agent session worktrees are local-only state, never source
.claude/worktrees/

# transient scratch/snapshot copies dropped by tooling (never source; must not
# be tracked or linted — a stale repo copy here otherwise fails `eslint .`)
.tmp/

# Capacitor / native iOS build artifacts. The ios/ project is generated on a Mac
# via `npm run cap:add:ios` (see docs/app-store/SUBMISSION.md). These are copied
# web assets, CocoaPods, and Xcode build output — regenerated by `cap sync`, so
# they must never be committed. The Xcode project itself may be committed.
ios/App/Pods/
ios/App/App/public/
ios/App/output/
ios/App/build/
ios/DerivedData/
ios/capacitor-cordova-ios-plugins/
*.xcuserstate
DerivedData/
# @capacitor/assets source art (optional; generated icon sets are committed)
/assets/
